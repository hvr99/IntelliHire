# ==============================================================================
# Environment Configuration Template (.env.example)
# DO NOT put real secrets in this file. Copy to .env for local configuration.
# ==============================================================================

# Database Configuration (Local PostgreSQL 16)
DB_URL=jdbc:postgresql://localhost:5432/job_platform
DB_USER=postgres
DB_PASSWORD=your_local_db_password

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_256_bits_for_hs256_placeholder
JWT_EXPIRY_MINUTES=60
INTERNAL_API_KEY=your_internal_service_api_key_placeholder

# Service Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
JOB_SERVICE_PORT=8083
APPLICATION_SERVICE_PORT=8084
RECOMMENDATION_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
ML_SERVICE_PORT=8000
FRONTEND_PORT=3000

# Service Base URLs (Local Development)
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
JOB_SERVICE_URL=http://localhost:8083
APPLICATION_SERVICE_URL=http://localhost:8084
RECOMMENDATION_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
ML_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
